title: Election
on-arrival: {!
 
// calculate normalized class voting amounts (0 to 100)
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) Q[c+'_'+party] = 0;
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        var share = class_votes > 0 ? 100 * Q[c+'_'+party] / class_votes : 0;
        Q[c + '_' + party + '_normalized'] = share;
        Q[c + '_' + party + '_display'] = Math.round(share * 10) / 10;
    }
}
 
// 1. calculate support for each of the parties
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            // "spillover" version: allows wilder swings and working-class-only strategies
            party_support += Q[c]*Q[c+'_'+party];
        } else {
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}
 
// 2. normalize support to a fraction, 3. round to one decimal
for (var party of Q.parties) {
    var frac = total_support > 0 ? Q[party + '_support'] / total_support : 0;
    Q[party + '_normalized'] = frac;
    Q[party + '_votes_dec']  = Math.round(frac * 1000) / 10;
    Q[party + '_votes']      = Q[party + '_votes_dec'];
    Q[party + '_votes_disp'] = Q[party + '_votes_dec'].toFixed(1);
}
!}
go-to: jumpScene
 
# note: this is a helpful utility to deal with elections and so on.
