title: Post Event
new-page: true
on-arrival: {!

const IDEO_KEYWORDS = [
    [/marxism-leninism/i,                 1],
    [/council communism/i,                0],
    [/national bolshevism/i,              16],
    [/syndicalist communism/i,            1],

    [/revolutionary socialism/i,          2],
    [/left-wing socialism/i,              3],
    [/anarcho-syndicalism/i,              1],
    [/luxemburgism/i,                     2],

    [/old social democracy/i,             14],
    [/social democracy \(revolutionary\)/i,      3],
    [/social democracy \(center marxist\)/i,     4],
    [/social democracy \(reformist\)/i,          6],
    [/laborism/i,                                7],
    [/social republicanism \(neorevisionist\)/i, 8],
    [/right-wing social democracy/i,      12],
    [/guild socialism/i,                  5],
    [/christian syndicalism/i,            8],

    [/social democracy/i,                 6],
    [/social republicanism/i,             7],

    [/catholic laborism/i,                10],
    [/progressive liberalism/i,           9],

    [/social liberalism/i,                9],
    [/christian socialism/i,              7],
    [/authoritarian catholic tent/i,      14],
    [/catholic tent/i,                    12],
    [/middle-class interest/i,            13],
    [/social corporatism/i,               15],
    [/corporatism/i,                      15],
    [/technocratic centrism/i,            10],
    [/radical democratic republicanism/i, 8],

    [/christian conservatism/i,           14],
    [/bavarian conservatism/i,            13],
    [/protestant social conservatism/i,   13],
    [/moderate conservatism/i,            14],
    [/liberal agrarianism/i,              12],
    [/regionalist particularism/i,        11],
    [/rhenish federalism/i,               11],

    [/national liberalism \(scholzite\)/i,       17],
    [/national liberalism \(dingeldist\)/i,       16],
    [/authoritarian national liberalism/i,        18],
    [/national liberalism/i,                      14],
    [/hanoverian agrarianism/i,                   15],
    [/hanseatic agrarian conservatism/i,          15],
    [/prussian legitimist monarchism/i,           16],

    [/völkisch liberalism/i,              16],
    [/populist agrarian conservatism/i,   16],
    [/agrarian conservatism/i,            17],
    [/junker reactionism/i,               19],

    [/national conservatism \(hugenbergite\)/i,   18],
    [/national conservatism/i,            18],
    [/authoritarian monarchism/i,         19],
    [/stahlhelm veterans conservatism/i,  18],

    [/national socialism \(strasserism\)/i,      18],
    [/strasserist national socialism/i,          18],
    [/national socialism/i,               20],
    [/völkisch nationalism/i,             20],
    [/strasserism/i,                      18],
    [/black reichswehr militarism/i,      19],

    // REST

    [/left socialism/i,           3],
    [/bavarian regionalism/i,     13],
];

function ideoScore(ideologyString) {
    if (!ideologyString) return 10;
    for (const [pattern, score] of IDEO_KEYWORDS) {
        if (pattern.test(ideologyString)) return score;
    }
    return 10;
}

for (const p of Q.parties) {
    const ideology = Q[p + '_ideology'];
    if (ideology !== undefined) {
        Q[p + '_ideo_score'] = ideoScore(ideology);
    }
}

Q.parties = [...new Set(Q.parties)];

for (const party of Q.parties) {
    Q[party + '_in_government'] = Q[party + '_in_government'] ?? 0;
}

// === VARIABLE RANGE CAPPING ===

Q.capped_var_ranges = {
    // 0 to 10
    pro_consumer:              [0, 10],
    agricultural_finance:      [0, 10],
    land_reform:               [0, 10],
    socialization:             [0, 10],
    commonwealth_cooperation:  [0, 10],
    cooperatives:              [0, 10],
    economic_democracy:        [0, 20],
    workers_safety:            [0, 10],
    working_hours:             [0, 10],
    womens_rights:             [0, 10],

    // -10 to 10
    welfare:                   [-10, 10],
    judicial_reform:           [-10, 10],
    pacifism:                  [-10, 10],
    radicalization:            [-10, 10],
    democratization:           [-10, 10],

    // -1 to 2
    confronting_antisemitism:  [-1, 2],

    // 0 to 15
    workers_aid:               [0, 15],
    campaign_media:            [0, 15],
    commercialized_media:      [0, 15],
    cultural_organizations:    [0, 15],
    wtb_support:               [0, 15],
    local_rally:               [0, 15],
    peoples_party_support:     [0, 15]
};

Q.apply_var_caps = function() {
    for (var varName in Q.capped_var_ranges) {
        if (!Q.capped_var_ranges.hasOwnProperty(varName)) continue;
        if (Q[varName] === undefined) continue; // skip vars not in use

        var range = Q.capped_var_ranges[varName];
        var min = range[0];
        var max = range[1];

        if (Q[varName] < min) {
            Q[varName] = min;
        } else if (Q[varName] > max) {
            Q[varName] = max;
        }
    }
};

Q.apply_var_caps();


// QOL. REMOVES PHANTON PARTIES.

const inGov = Object.keys(Q)
  .filter(key => key.endsWith("_in_government") && Q[key] == 1)
  .map(key => key.replace("_in_government", ""))
  .filter(party => (Q[party + "_votes"] > 0) && (Q[party + "_r"] > 0))
  .map(party => party.toUpperCase());

Q.parties_in_government_display = inGov.length > 0
  ? inGov.join(", ")
  : "None";


// 1. update dates
if (Q.month_actions >= 1) {
    Q.month_actions_2 = 1;
    Q.time += 1;
    Q.month_actions = 0;
    if (Q.hitler_rubicon >= 1) {
      Q.weeks += 1;
      Q.week = Q.weeks;
    } else {
      Q.weeks += 2;
    }
    if (Q.weeks >= 4) {
        Q.month += 1;
        Q.weeks = 0;
    }
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
    }
    if (Q.fundraiser_timer <= 0) {
        Q.workers_income = Math.round((Q.workers_spd * Q.workers_dues * (1 - Q.labor_dissent / 100) * 0.40) / 10)
        Q.unemployed_income = Math.round((Q.unemployed_spd * Q.unemployed_dues * (1 - Q.left_dissent / 100) * 0.35) / 10)
        Q.new_middle_income = Math.round((Q.new_middle_spd * Q.new_middle_dues * (1 - Q.labor_dissent / 100) * 0.35) / 10)
        Q.old_middle_income = Math.round((Q.old_middle_spd * Q.old_middle_dues * (1 - Q.reformist_dissent / 100) * 0.15) / 10)
        Q.rural_income = Math.round((Q.rural_spd * Q.rural_dues * (1 - Q.reformist_dissent / 100) * 0.20) / 10)

        Q.resources += Q.workers_income + Q.unemployed_income + Q.new_middle_income + Q.old_middle_income + Q.rural_income

        Q.income_summary = "Workers: +" + Q.workers_income + ", Unemployed: +" + Q.unemployed_income + ", New Middle: +" + Q.new_middle_income + ", Old Middle: +" + Q.old_middle_income + ", Rural: +" + Q.rural_income;

        Q.fundraiser_timer = 24;
    }
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployed});








    // change economic stats...
    // we're basically implicity drawing a Philips curve
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 5) {
        Q.inflation += 0.2;
        if (Q.unemployed >= 12) {
            Q.inflation -= 0.1;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 10) {
        Q.inflation += 0.3;
        if (Q.unemployed >= 15) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -5 && Q.unemployed < 15) {
        Q.unemployed += 0.2;
    }
    if (Q.inflation <= -5 && Q.unemployed < 20) {
        Q.unemployed += 0.3;
    }
    // economic growth
    if (Q.economic_growth < -0.5 && Q.unemployed <= 18) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth < -5 && Q.unemployed <= 28) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth >= 2 && Q.unemployed >= 17) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.unemployed >= 12) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 6 && Q.unemployed >= 7) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 8 && Q.unemployed >= 3) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.inflation >= 7.5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2.5 && Q.inflation <= -5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 7) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 10) {
        Q.economic_growth -= 0.2;
    }
    if (Q.economic_growth >= 12) {
        Q.economic_growth -= 0.3;
    }

    //////////////////////////////// Education & Science support/economic changes
    if (Q.major_curriculum && Q.major_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.5;
        } 
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.3;
        } 
    }
    // science bonus to economic growth
    // education bonus
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 1) {
            Q.science_bonus += 1;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 5) {
            Q.science_bonus += 3;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    console.log(Q.science_bonus);
    // this is kinda messy but basically more science -> higher levels of baseline growth
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus + 3) {
            Q.economic_growth += 0.1;
        }
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus) {
            Q.economic_growth += 0.1;
        }
        if (Q.economic_growth < Q.science_bonus - 3) {
            Q.economic_growth += 0.1;
        }
    }
    // accumulated economic growth/decline
    // Maybe there should be differences for positive/negative growth?
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.reparations <= -2 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth;
    } else if (Q.economic_growth > 0 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth/2;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.unemployed > 15 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }
    if (Q.unemployed > 30 && Q.pro_republic > 20) {
        Q.pro_republic -= 1;
    }
    if (Q.inflation >= 8 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }

    ///////////////////////////// change party support based on pro_republic
    // if pro_republic is less than the support of the Weimar coalition, reduce SPD support...
    if (Q.pro_republic < (Q.spd_votes + Q.ddp_votes + Q.z_votes)) {
        if (Q.new_middle_spd > 0) {
            Q.new_middle_spd -= 5/12;
            Q.new_middle_nsdap += 3/12;
        }
        if (Q.old_middle_spd > 0) {
            Q.old_middle_spd -= 5/12;
            Q.old_middle_nsdap += 3/12;
        }
        if (Q.rural_spd > 0) {
            Q.rural_spd -= 5/12;
        }
        if (Q.workers_spd_normalized > 30) {
            Q.workers_spd -= 4/12;
        }
        if (Q.catholics_spd > 0) {
            Q.catholics_spd -= 4/12;
        }
        if (Q.unemployed_spd_normalized > 10) {
            Q.unemployed_spd -= 4/12;
        }
        if (Q.new_middle_ddp > 0) {
            Q.new_middle_ddp -= 4/12;
            Q.new_middle_nsdap += 3/12;
        }
        if (Q.old_middle_ddp > 0) {
            Q.old_middle_ddp -= 5/12;
            Q.old_middle_nsdap += 4/12;
        }
        if (Q.rural_ddp > 0) {
            Q.rural_ddp -= 5/12;
            Q.rural_nsdap += 4/12;
        }
    }

////////////////////////// annual support changes

function calcSeverity(Q) {
    var unemployment_severity = Math.max(0, (Q.unemployed - 1) / 19);      // 1% baseline, ~1.0 at 20%
    var deflation_severity = Math.max(0, (-Q.inflation - 1) / 5);          // starts above -1%, ~1.0 at -6%
    var inflation_severity = Math.max(0, (Q.inflation - 1) / 4);           // starts above 1%, ~1.0 at 5%
    var growth_severity = Math.max(0, (-Q.economic_growth - 0.5) / 2.5);   // starts below -0.5%, ~1.0 at -3%
    var severity = unemployment_severity + Math.max(deflation_severity, inflation_severity) + growth_severity;
    return Math.min(severity, 1.75);
}
Q.severity = calcSeverity(Q);
console.log('economic severity: ' + Q.severity);




// ===== (party distress) =====
Q.economy_bad = (Q.severity >= 1) ? 1 : 0;   

if (Q.economy_bad) {
    if (!(Q.hunger_timer >= 0)) {            
        Q.hunger_timer = 24 - Math.min(6, Math.round(Q.severity * 3.5));
    }
    Q.party_crisis = (Q.hunger_timer == 0) ? 1 : 0;
} else {
    Q.party_crisis = 0;
    if (Q.hunger_timer == 0) Q.hunger_timer = -1;   
}



// ===== FUNDS (dues) =====
var dues_limit = { workers: 4, old_middle: 4, new_middle: 4, unemployed: 2, rural: 3 };

var any_over = false;   // any class at its limit
var any_above = false;  // any class past its limit

for (var cls in dues_limit) {
    var d = Q[cls + '_dues'];
    if (d > 1) Q[cls + '_spd'] -= (d - 1) * 0.1;   // independent monthly drain
    if (d >= dues_limit[cls]) any_over = true;
    if (d > dues_limit[cls]) any_above = true;
}

if (any_over) {
    if (!(Q.funds_timer >= 0)) {
        Q.funds_timer = any_above ? 18 : 24;
    }
    Q.funds_trigger = (Q.funds_timer == 0) ? 1 : 0;
} else {
    Q.funds_trigger = 0;
    if (Q.funds_timer == 0) Q.funds_timer = -1;
}



if (Q.year == 1928) {
    if (Q.dnvp_in_government == 1) {
        Q.rural_dnvp -= 8/12;
        Q.rural_other += 6/12;
    }
        Q.workers_z -= 0.5/12;
        Q.workers_nsdap -= 1/12;
        Q.rural_dnvp -= 3/12;
        Q.old_middle_dnvp -= 6/12;
        Q.new_middle_dnvp -= 6/12;
        Q.rural_other += 8/12;
        Q.old_middle_other += 9/12;
        Q.new_middle_other += 9/12;
        Q.old_middle_dvp -= 8/12;
        Q.new_middle_dvp -= 8/12;
        Q.old_middle_ddp -= 8/12;
        Q.new_middle_ddp -= 4/12;
        Q.workers_kpd += 2/12;
        Q.workers_spd += 2/12;
        Q.unemployed_kpd += 4/12;
}
if (Q.year == 1929) {
    Q.unemployed += 1/12;
    Q.inflation -= 0.5/12;
    Q.sa_strength += 20/12;
    Q.sh_strength += 40/12;

    Q.new_middle_nsdap += (7.5/12) * Q.severity;
    Q.old_middle_nsdap += (7.5/12) * Q.severity;
    Q.new_middle_ddp -= (3.75/12) * Q.severity;
    Q.new_middle_dvp -= (3.75/12) * Q.severity;
    Q.workers_kpd += (3.75/12) * Q.severity;
    Q.sa_strength += (22.5/12) * Q.severity;
    Q.sh_strength += (45/12) * Q.severity;
    Q.rural_dnvp -= (11.25/12) * Q.severity;
    Q.rural_nsdap += (7.5/12) * Q.severity;
    Q.unemployed_nsdap += (13.5/12) * Q.severity;

} else if (Q.year == 1930) {
    Q.rural_other += 5/12;

    Q.rural_nsdap += (7.5/12) * Q.severity;
    Q.rural_dnvp -= (11.25/12) * Q.severity;
    Q.new_middle_dvp -= (3.75/12) * Q.severity;
    Q.old_middle_dvp -= (4.5/12) * Q.severity;
    Q.new_middle_ddp -= (3.75/12) * Q.severity;
    Q.old_middle_ddp -= (4.5/12) * Q.severity;
    Q.new_middle_nsdap += (7.5/12) * Q.severity;
    Q.old_middle_nsdap += (7.5/12) * Q.severity;
    Q.new_middle_other += (3/12) * Q.severity;
    Q.old_middle_other += (3/12) * Q.severity;
    Q.unemployed_nsdap += (6/12) * Q.severity;

    Q.workers_z += 1/12;
    Q.old_middle_z += 2/12;
    Q.new_middle_z += 2/12;

    if (!Q.works_program) {
        Q.rural_nsdap += (2.25/12) * Q.severity;
        Q.old_middle_nsdap += (3.75/12) * Q.severity;
        Q.workers_nsdap += (1.5/12) * Q.severity;
        Q.workers_other += (3.75/12) * Q.severity;
        Q.workers_kpd += (1.5/12) * Q.severity;
    }
    Q.sa_strength += (75/12) * Q.severity;
    Q.sh_strength += (75/12) * Q.severity;

} else if (Q.year == 1931) {
    Q.catholics_z += 2/12;
    Q.sa_militancy += 0.1/12;

    Q.rural_dvp -= (6/12) * Q.severity;
    Q.old_middle_dvp -= (6/12) * Q.severity;
    Q.new_middle_dvp -= (6/12) * Q.severity;
    Q.old_middle_ddp -= (6/12) * Q.severity;
    Q.new_middle_ddp -= (6/12) * Q.severity;
    Q.sa_strength += (37.5/12) * Q.severity;
    Q.sh_strength += (37.5/12) * Q.severity;
    Q.old_middle_nsdap += (7.5/12) * Q.severity;
    Q.rural_other -= (3.75/12) * Q.severity;
    Q.rural_nsdap += (6.75/12) * Q.severity;

    if (!Q.works_program) {
        Q.old_middle_dvp -= (4.5/12) * Q.severity;
        Q.new_middle_dvp -= (4.5/12) * Q.severity;
        Q.rural_dvp -= (4.5/12) * Q.severity;
        Q.workers -= (3/12) * Q.severity;
        Q.unemployed_nsdap += (5.25/12) * Q.severity;
        Q.unemployed_kpd += (1.5/12) * Q.severity;
        Q.rural_other -= (9/12) * Q.severity;
        Q.rural_nsdap += (9/12) * Q.severity;
        Q.new_middle_nsdap += (9/12) * Q.severity;
        Q.old_middle_nsdap += (9/12) * Q.severity;
        Q.workers_nsdap += (1.5/12) * Q.severity;
        Q.workers_kpd += (3/12) * Q.severity;
        Q.sa_strength += (75/12) * Q.severity;
        Q.sh_strength += (37.5/12) * Q.severity;
    } else if (Q.unemployed > 15) {
        Q.old_middle_dvp -= (3/12) * Q.severity;
        Q.new_middle_dvp -= (3/12) * Q.severity;
        Q.rural_dvp -= (3/12) * Q.severity;
        Q.unemployed_nsdap += (3/12) * Q.severity;
        Q.old_middle_nsdap += (3/12) * Q.severity;
        Q.new_middle_nsdap += (3/12) * Q.severity;
        Q.rural_nsdap += (3/12) * Q.severity;
    }

} else if (Q.year == 1932) {
    Q.old_middle_other -= (5.25/12) * Q.severity;
    Q.rural_other -= (5.25/12) * Q.severity;
    Q.old_middle_nsdap += (5.25/12) * Q.severity;
    Q.rural_nsdap += (5.25/12) * Q.severity;
    Q.unemployed_nsdap += (3/12) * Q.severity;

    if (!Q.works_program) {
        Q.unemployed += 5/12;
        Q.inflation -= 2/12;
        Q.catholics_z += 2/12;
        Q.workers -= (3/12) * Q.severity;
        Q.rural_dnvp -= (3/12) * Q.severity;
        Q.rural_nsdap += (6/12) * Q.severity;
        Q.new_middle_nsdap += (7.5/12) * Q.severity;
        Q.old_middle_nsdap += (7.5/12) * Q.severity;
        Q.unemployed_nsdap += (6/12) * Q.severity;
        Q.unemployed_kpd += (1.5/12) * Q.severity;
        Q.workers_nsdap += (2.25/12) * Q.severity;
        Q.workers_kpd += (2.25/12) * Q.severity;
        Q.sa_strength += (150/12) * Q.severity;
        Q.new_middle_dnvp += (3/12) * Q.severity;
        Q.old_middle_dnvp += (3/12) * Q.severity;
        Q.new_middle_dvp -= (3/12) * Q.severity;
        Q.old_middle_dvp -= (3/12) * Q.severity;
        Q.rural_dvp -= (3/12) * Q.severity;
    } else if (Q.unemployed > 25) {
        Q.rural_nsdap += (3.75/12) * Q.severity;
        Q.unemployed_nsdap += (3.75/12) * Q.severity;
        Q.old_middle_nsdap += (3.75/12) * Q.severity;
        Q.new_middle_nsdap += (3/12) * Q.severity;
        Q.sa_strength += (37.5/12) * Q.severity;
    } else if (Q.unemployed > 20) {
        Q.rural_nsdap += (1.5/12) * Q.severity;
        Q.unemployed_nsdap += (2.25/12) * Q.severity;
        Q.old_middle_nsdap += (2.25/12) * Q.severity;
        Q.new_middle_nsdap += (1.5/12) * Q.severity;
    }

} else if (Q.year >= 1933) {
    if (Q.return_to_normalcy) {
        if (Q.new_middle_ddp_normalized < 40) { Q.new_middle_ddp += 6/12; }
        if (Q.new_middle_dvp_normalized < 25) { Q.new_middle_dvp += 3/12; }
        if (Q.old_middle_dvp_normalized < 40) { Q.old_middle_dvp += 6/12; }
        if (Q.rural_dnvp_normalized < 40) { Q.rural_dnvp += 6/12; }
        if (Q.catholics_z_normalized < 40) { Q.catholics_z += 6/12; }
    }
    if (Q.unemployed > 10) {
        Q.rural_nsdap += (1.5/12) * Q.severity;
        Q.unemployed_nsdap += (1.5/12) * Q.severity;
        Q.old_middle_nsdap += (1.5/12) * Q.severity;
        Q.new_middle_nsdap += (1.5/12) * Q.severity;
        if (Q.spd_in_government) {
            Q.workers_spd -= (3/12) * Q.severity;
        }
    }
}
    // prevent forever support if the economy is bad
    if (Q.year >= 1934 && (Q.inflation >= 8 || Q.unemployed >= 20) && Q.pro_republic <= 45 && Q.spd_in_government) {
        if (Q.workers_spd_normalized > 40) {
            Q.workers_spd -= 6/12;
        }
        if (Q.unemployed_spd_normalized > 20) {
            Q.unemployed_spd -= 6/12;
        }
        if (Q.new_middle_spd_normalized > 20) {
            Q.new_middle_spd -= 6/12;
        }
        if (Q.old_middle_spd_normalized > 20) {
            Q.old_middle_spd -= 6/12;
        }
        if (Q.rural_spd_normalized > 20) {
            Q.rural_spd -= 6/12;
        }
        if (Q.catholics_spd_normalized > 20) {
            Q.catholics_spd -= 6/12;
        }
    }

if (Q.year >= 1935) {
    let growth_factor = Math.max(0, Q.economic_growth / 6);
    let employment_factor = Math.max(0, (12 - Q.unemployed) / 8);
    let stability_factor = (Q.inflation >= -1 && Q.inflation <= 5) ? 1.0 : 0.2;

    let bliss_index = (growth_factor + employment_factor) * stability_factor;

    if (Q.return_to_normalcy || bliss_index >= 0.8) {
        let decay_coefficient = Q.return_to_normalcy ? 0.25 : Math.min(0.40, 0.15 * bliss_index);

        const target_reabsorption = {
            'workers':     { 'spd': 0.50, 'kpd': 0.20, 'other': 0.30 },
            'unemployed':  { 'spd': 0.40, 'kpd': 0.40, 'other': 0.20 },
            'new_middle':  { 'ddp': 0.40, 'dvp': 0.30, 'spd': 0.30 },
            'old_middle':  { 'dvp': 0.40, 'other': 0.40, 'dnvp': 0.20 },
            'rural':       { 'dnvp': 0.40, 'other': 0.40, 'spd': 0.20 },
            'catholics':   { 'z': 0.80, 'spd': 0.20 }
        };

        for (let c of Q.classes) {
            let nsdap_key = `${c}_nsdap`;
            let current_nsdap = Q[nsdap_key] || 0;

            if (current_nsdap > 5) {
                let excess_support = current_nsdap - 5;
                let drained_voters = (excess_support * decay_coefficient) / 12;

                drained_voters = Math.min(drained_voters, current_nsdap - 2);
                Q[nsdap_key] -= drained_voters;

                let class_targets = target_reabsorption[c] || { 'other': 1.0 };
                for (let target_party in class_targets) {
                    let share = class_targets[target_party];
                    let destination_key = `${c}_${target_party}`;

                    if (Q[destination_key] !== undefined) {
                        Q[destination_key] += drained_voters * share;
                    } else {
                        Q[`${c}_other`] = (Q[`${c}_other`] || 0) + (drained_voters * share);
                    }
                }
            }
        }
    }
}










// ENDS HERE, MONTH ACTIONS..!!!
}













Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.
var decimal_factor = Math.pow(10, Q.use_decimals || 0);

// ---- 0. Sanity clamps ----
if (Q.unemployed < 1) Q.unemployed = 1;

for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        var key = c + '_' + party;
        Q[key] = Math.max(0, Q[key] || 0);
        class_votes += Q[key];
    }
    for (var party of Q.parties) {
        var key = c + '_' + party;
        var share = class_votes > 0 ? 100 * Q[key] / class_votes : 0;
        Q[key + '_normalized'] = share;
        Q[key + '_display'] = Math.round(decimal_factor * share) / decimal_factor;
    }
}


var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        var k = c + '_' + party + (Q.old_demographics ? '' : '_normalized');
        party_support += Q[c] * Q[k];
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}

for (var party of Q.parties) {
    var frac = total_support > 0 ? Q[party + '_support'] / total_support : 0;
    Q[party + '_normalized'] = frac;
    Q[party + '_votes'] = Math.round(frac * 100);
    Q[party + '_votes_display'] = Math.round(decimal_factor * frac * 100) / decimal_factor;
}

for (var f of Q.factions) {
    Q[f + '_dissent']  = Math.min(99, Math.max(0, Q[f + '_dissent']  || 0));
    Q[f + '_strength'] = Math.max(0, Q[f + '_strength'] || 0);
}

var active = Q.factions.filter(function(f) {
    if (f === 'neorevisionist') return Q.neorevisionism >= 1;
    if (f === 'socialpatriot')  return Q.social_patriotism == 1;
    return true;
});

var faction_total = 0;
active.forEach(function(f) { faction_total += Q[f + '_strength']; });

var weighted_dissent = 0; // sum of (strength% * dissent%)
if (faction_total > 0) {
    active.forEach(function(f) {
        Q[f + '_strength'] = 100 * Q[f + '_strength'] / faction_total;
        weighted_dissent += Q[f + '_strength'] * Q[f + '_dissent'];
    });
}

Q.dissent = Math.min(0.99, Math.max(0, weighted_dissent / 10000));
Q.dissent_percent = Q.dissent * 100;
console.log('new dissent: ' + Q.dissent);




// NORMALIZER

// Helper function to normalize a list of keys on Q to a target sum
function normalizeKeys(keys, targetSum) {
  const total = keys.reduce((sum, key) => sum + (Q[key] || 0), 0);
  if (total > 0) {
    for (const key of keys) {
      Q[key] = Math.round((Q[key] / total) * targetSum * 10) / 10;
    }
  }
}

// 1. Normalize classes to total 100
normalizeKeys(Q.classes, 100);

// 2. Normalize ideology metrics to total 150
normalizeKeys(['pro_republic', 'nationalism', 'socialism'], 150);





if (Q.month_actions_2 >= 1) {

Q.month_actions_2 = 0;


/////  CUSTOM CODE CUSTOM CODE CUSTOM CODE CUSTOM CODE CUSTOM CODE CUSTOM CODE CUSTOM CODE CUSTOM CODE 


// ============================================================================
// 2. STATE REACTION VECTOR & PREREQUISITES
// ============================================================================

Q.interior_purged = (Q.interior_police_loyalty >= 0.90) ? 1 : 0;

Q.reaction_progress = 0;
Q.reaction_threshold = 5;

if (Q.reaction_activated !== 1) {
    if (Q.investigate_corruption >= 3) Q.reaction_progress += 1;
    if (Q.bureaucracy_purged === 1) Q.reaction_progress += 0.5;
    if (Q.rural_cooperatives + Q.cooperatives + Q.socializations >= 3) Q.reaction_progress += 1;
    if (Q.interior_purged === 1) Q.reaction_progress += 0.5;
    if (Q.land_reform >= 1) Q.reaction_progress += 0.5 * Q.land_reform;
    if (Q.nationalization_progress >= 1) Q.reaction_progress += 1 * Q.nationalization_progress;
    if (Q.factory_takeovers >= 1) Q.reaction_progress += Q.factory_takeovers;
    if (Q.kpd_in_government >= 1) Q.reaction_progress += 3;
    if (Q.socialism >= 65) Q.reaction_progress += 1;
}

Q.junker_land_reform_enabled = (
    Q.socialism >= 100 || 
    Q.rural_spd >= 40 || 
    Q.spd_votes >= 50 || 
    Q.in_spd_majority >= 1 || 
    Q.in_popular_front || 
    Q.in_left_front
) ? 1 : 0;


// SPD Powerhouse relation drops.

if (Q.spd_votes >= 40) {
    let excess = Q.spd_votes - 40;

    Q.dvp_relation -= excess * 0.1;
    Q.z_relation -= excess * 0.05;
    Q.ddp_relation -= excess * 0.025;
}


// Marxist majority
let marxist_votes = (Q.spd_votes || 0) + (Q.kpd_votes || 0) + (Q.sapd_votes || 0);

if (marxist_votes >= 50 && (Q.ideology === "left" || Q.ideology === "centrist")) {
    Q.socialism += 1;
    Q.left_strength += 0.5;
    Q.kpd_relation += 0.5;
    if (Q.ideology === "Left") {
        Q.kpd_relation += 0.5;
    }
    if (Q.kpd_relation >= 50) {
        Q.communist_coalition += 0.2;
    }
    Q.sapd_relation += 0.5;
}


// MODIFIERS OF PARTY ADVISORS AND OTHER STUFF

if (Q.peoples_party == 1) {
    if (Q.left_dissent < 45) Q.left_dissent += 1;
    if (Q.left_strength > 30) Q.left_strength -= 0.5;
    if (Q.center_dissent < 40) Q.center_dissent += 1;
    if (Q.reformist_strength < 30) Q.reformist_strength += 1;
    if (Q.neorevisionist_strength < 20) Q.neorevisionist_strength += 1;
}

const strengthMap = {
    Left: "left_strength",
    Centrist: "center_strength",
    Labor: "labor_strength",
    Reformist: "reformist_strength",
    Neorev: "neorevisionist_strength"
};
const key = strengthMap[Q.ideology];
if (key && Q[key] < 40) { Q[key] += 1; }



// LEFT SPD SPECIFICS

if (Q.ideology == "Left") {
    Q.dvp_relation -= 0.5;
    Q.ddp_relation -= 0.2;
    Q.z_relation -= 0.3;
    Q.kpd_relation += 0.2;
}

if (Q.ideology == "Reformist") {
    Q.dvp_relation += 0.2;
    Q.ddp_relation += 0.3;
    Q.z_relation += 0.3;
    Q.kpd_relation -= 0.7;
    Q.dnvp_relation += 0.01;
}

// LEFT SPD: soft-cap non-worker/unemployed classes
if (Q.ideology == "Left") {
    var left_soft_cap = 20;
    var left_bonus_classes = ["workers", "unemployed"];
    var left_capped_classes = Q.classes.filter(function(c) {
        return left_bonus_classes.indexOf(c) === -1;
    });

    for (var c of left_capped_classes) {
        var norm_key = c + "_spd_normalized";
        if (Q[norm_key] > left_soft_cap) {
            var excess = Q[norm_key] - left_soft_cap;
            Q[c + "_spd"] -= (excess * 0.05) / 12;
        }
    }
    Q.workers_spd += 2 / 12;
    Q.unemployed_spd += 2 / 12;
}

// Settings

Q.dvp_rightist = (Q.dvp_party_leader == "Scholz") ? 1 : 0;
Q.youth_crisis_spd = ((Q.new_middle_consciousness >= 1 || Q.iron_front_formed >= 1 || Q.peoples_party >= 1) && Q.young_socialists >= 2) ? 0 : 1;

Q.spd_left = (Q.ideology == "Left") ? 1 : 0;
Q.spd_centrist = (Q.ideology == "Centrist") ? 1 : 0;
Q.spd_reformist = (Q.ideology == "Reformist") ? 1 : 0;
Q.spd_labor = (Q.ideology == "Labor") ? 1 : 0;
Q.spd_neorevisionist = (Q.ideology == "Neorevisionist") ? 1 : 0;


// YOUTH DECAY

if (Q.youth_crisis_spd >= 1) {
    Q.workers_spd -= 0.1;
    Q.new_middle_spd -= 0.05;
    Q.unemployed -= 0.05;
}





for (const party of Q.parties) {
    var timerKey = party + '_action';
    if (!Q.timers.includes(timerKey)) {
        Q.timers.push(timerKey);
    }
    if (Q[timerKey + '_timer'] === undefined) {
        Q[timerKey + '_timer'] = 0;
    }

    var flavorTimerKey = party + '_flavor_action';
    if (!Q.timers.includes(flavorTimerKey)) {
        Q.timers.push(flavorTimerKey);
    }
    if (Q[flavorTimerKey + '_timer'] === undefined) {
        Q[flavorTimerKey + '_timer'] = 0;
    }

    var govTimerKey = party + '_government_action';
    if (!Q.timers.includes(govTimerKey)) {
        Q.timers.push(govTimerKey);
    }
    if (Q[govTimerKey + '_timer'] === undefined) {
        Q[govTimerKey + '_timer'] = 0;
    }

    var govFlavorTimerKey = party + '_government_flavor_action';
    if (!Q.timers.includes(govFlavorTimerKey)) {
        Q.timers.push(govFlavorTimerKey);
    }
    if (Q[govFlavorTimerKey + '_timer'] === undefined) {
        Q[govFlavorTimerKey + '_timer'] = 0;
    }
}

function isParty(party, targetParties) {
    if (!party || !targetParties) return false;
    var targets = Array.isArray(targetParties) ? targetParties : [targetParties];
    return targets.some(t => t && party.toLowerCase() === t.toLowerCase());
}


// PARTY ACTIONS

function PickHighest(list, prop) {
    var bestKey = null;
    var bestVal = -Infinity;
    for (var key in list) {
        if (!list[key].eligible) continue;
        var val = list[key][prop];
        if (typeof val !== 'number' || Number.isNaN(val)) continue; // guard against undefined/NaN weights so a broken Q value can never win or lock up the comparison
        if (val > bestVal) {
            bestVal = val;
            bestKey = key;
        }
    }
    return bestKey;
}

function scaledWeight(baseWeight, currentValue, baseValue, maxMultiplier = 5) {
    var ratio = Math.min(baseValue / Math.max(currentValue, 1), maxMultiplier);
    return baseWeight * ratio;
}

function linearWeight(baseWeight, currentValue, baseValue, maxMultiplier = 5) {
    var ratio = Math.max(currentValue, 0) / baseValue;
    ratio = Math.min(ratio, maxMultiplier);
    return baseWeight * ratio;
}

function inIdeoRange(party, min, max) {
    var score = Q[party + '_ideo_score'];
    if (score === undefined) return false;
    return score >= min && score <= max;
}

function weakestClass(party) {
    var best = null, lowest = Infinity;
    for (const c of Q.classes) {
        var v = Q[c + '_' + party] || 0;
        if (v < lowest) { lowest = v; best = c; }
    }
    return best;
}

