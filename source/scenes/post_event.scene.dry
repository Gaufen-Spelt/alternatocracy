title: Post Event
new-page: true
on-arrival: {!
// ============================================================================
// SYSTEM UTILITIES & UTILITY FUNCTIONS
// ============================================================================

function cleanFloat(val, decimals = 4) {
    if (typeof val !== 'number' || isNaN(val)) return 0;
    var factor = Math.pow(10, decimals);
    return Math.round(val * factor) / factor;
}


function transferVoters(demographic, sourceParty, targetParty, rate) {
    var sourceKey = demographic + '_' + sourceParty;
    var targetKey = demographic + '_' + targetParty;

    if (Q[sourceKey] === undefined) Q[sourceKey] = 0;
    if (Q[targetKey] === undefined) Q[targetKey] = 0;

    var actualTransfer = Math.min(Q[sourceKey], rate);
    Q[sourceKey] = cleanFloat(Q[sourceKey] - actualTransfer);
    Q[targetKey] = cleanFloat(Q[targetKey] + actualTransfer);
}

// ============================================================================
// 1. TEMPORAL ENGINE & REVENUE COLLECTION
// ============================================================================

if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.weeks += 2;
    if (Q.weeks >= 4) {
        Q.month += 1;
        Q.weeks = 0;
    }
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
    }

    // Party Fundraiser - Dues Collection Cycle (Every 24 turns / 12 months)
    Q.fundraiser_timer += 1;
    if (Q.fundraiser_timer >= 24) {
        Q.fundraiser_timer = 0;

        // Collect floating-point dues across all sectors before floor operation
        var rawDues = 0;
        rawDues += (Q.workers_spd * Q.workers * (1 - Q.labor_dissent) * 0.40) / 10;
        rawDues += (Q.unemployed_spd * Q.unemployed * (1 - Q.left_dissent) * 0.35) / 10;
        rawDues += (Q.new_middle_spd * Q.new_middle * (1 - Q.labor_dissent) * 0.35) / 10;
        rawDues += (Q.old_middle_spd * Q.old_middle * (1 - Q.reformist_dissent) * 0.15) / 10;
        rawDues += (Q.rural_spd * Q.rural * (1 - Q.reformist_dissent) * 0.20) / 10;

        // Apply single Math.floor to aggregate value to prevent underflow erasure
        Q.resources += Math.floor(rawDues);
    }

    // Append to historical tracking arrays
    var partySupportResults = { 'date': new Date(Q.year, Q.month - 1) };
    for (var p of Q.parties) {
        partySupportResults[p] = cleanFloat(Q[p + '_normalized'] * 100, 2);
    }
    Q.party_support_records.push(partySupportResults);
    Q.economic_records.push({
        'date': new Date(Q.year, Q.month - 1),
        'inflation': cleanFloat(Q.inflation, 2),
        'unemployment': cleanFloat(Q.unemployed, 2)
    });
}

// ============================================================================
// 2. STATE REACTION VECTOR & PREREQUISITES
// ============================================================================

Q.interior_purged = (Q.interior_police_loyalty >= 0.90) ? 1 : 0;

Q.reaction_progress = 0;
Q.reaction_threshold = 5;

if (Q.reaction_activated !== 1) {
    if (Q.investigate_corruption >= 3) Q.reaction_progress += 1;
    if (Q.bureaucracy_purged === 1) Q.reaction_progress += 0.5;
    if (Q.rural_cooperatives + Q.cooperatives + Q.socializations >= 3) Q.reaction_progress += 1;
    if (Q.interior_purged === 1) Q.reaction_progress += 0.5;
    if (Q.land_reform >= 1) Q.reaction_progress += 0.5 * Q.land_reform;
    if (Q.nationalization_progress >= 1) Q.reaction_progress += 1 * Q.nationalization_progress;
    if (Q.factory_takeovers >= 1) Q.reaction_progress += Q.factory_takeovers;
    if (Q.kpd_in_government >= 1) Q.reaction_progress += 5;
    if (Q.socialism >= 65) Q.reaction_progress += 1;
}

Q.junker_land_reform_enabled = (
    Q.socialism >= 60 || 
    Q.rural_spd >= 30 || 
    Q.spd_votes >= 50 || 
    Q.in_spd_majority >= 1 || 
    Q.in_popular_front || 
    Q.in_left_front
) ? 1 : 0;

// ============================================================================
// 3. MACROECONOMIC ENGINE & PHILLIPS CURVE
// ============================================================================

// Deficit & Inflation Drivers
if (Q.budget < 0 && Q.budget > -2) {
    if (Q.inflation < 2.5) Q.inflation += 0.1;
} else if (Q.budget <= -2 && Q.budget > -5) {
    Q.inflation += 0.2;
    if (Q.unemployed >= 12) Q.inflation -= 0.1;
} else if (Q.budget <= -5) {
    Q.inflation += 0.3;
    if (Q.unemployed >= 15) Q.inflation -= 0.1;
}

// Continuous Deflationary Bounds
if (Q.inflation <= -0.5 && Q.inflation > -5 && Q.unemployed < 15) {
    Q.unemployed += 0.2;
} else if (Q.inflation <= -5 && Q.unemployed < 20) {
    Q.unemployed += 0.3;
}

// Economic Growth & Unemployment Adjustment
if (Q.economic_growth < -0.5) {
    if (Q.unemployed < 18) Q.unemployed += 0.1;
    if (Q.economic_growth <= -3.0 && Q.unemployed < 28) Q.unemployed += 0.1;
} else if (Q.economic_growth >= 2.0) {
    if (Q.unemployed > 3.0) Q.unemployed -= 0.1;
    if (Q.economic_growth >= 4.0 && Q.unemployed > 3.0) Q.unemployed -= 0.1;
    if (Q.economic_growth >= 6.0 && Q.unemployed > 3.0) Q.unemployed -= 0.1;
    if (Q.economic_growth >= 8.0 && Q.unemployed > 3.0) Q.unemployed -= 0.1;
}

// Science Bonus Calculation
Q.science_bonus = 0;
if (Q.education_science) Q.science_bonus += Q.education_science;
if (Q.science) {
    if (Q.science >= 1) Q.science_bonus += 1;
    if (Q.science >= 3) Q.science_bonus += 2;
    if (Q.science >= 5) Q.science_bonus += 3;
}
if (Q.applied_research) Q.science_bonus += 0.5 * Q.applied_research;
Q.science_bonus = Math.min(Q.science_bonus, 6);

// ============================================================================
// 4. HISTORICAL SHIFTS & ZERO-SUM REALIGNMENT
// ============================================================================

// Disillusionment Mechanics
if (Q.unemployed > 15 && Q.pro_republic > 40) Q.pro_republic -= 1;
if (Q.unemployed > 30 && Q.pro_republic > 20) Q.pro_republic -= 1;
if (Q.inflation >= 8 && Q.pro_republic > 40) Q.pro_republic -= 1;

// Coalition Collapse Dynamic
if (Q.pro_republic < (Q.spd_votes + Q.ddp_votes + Q.z_votes - 3)) {
    transferVoters('new_middle', 'spd', 'nsdap', 3/12);
    transferVoters('old_middle', 'spd', 'nsdap', 3/12);
    transferVoters('rural', 'spd', 'nsdap', 3/12);
    transferVoters('workers', 'spd', 'kpd', 4/12);
    transferVoters('catholics', 'spd', 'z', 4/12);
    transferVoters('unemployed', 'spd', 'kpd', 4/12);
    transferVoters('new_middle', 'ddp', 'nsdap', 3/12);
    transferVoters('old_middle', 'ddp', 'nsdap', 4/12);
    transferVoters('rural', 'ddp', 'nsdap', 4/12);
}

// Timeline Drivers
if (Q.year === 1929) {
    transferVoters('new_middle', 'ddp', 'nsdap', 10/12);
    transferVoters('old_middle', 'dvp', 'nsdap', 10/12);
    transferVoters('unemployed', 'other', 'nsdap', 18/12);
    transferVoters('workers', 'spd', 'kpd', 5/12);
}

if (Q.year === 1930) {
    transferVoters('new_middle', 'ddp', 'nsdap', 8/12);
    transferVoters('old_middle', 'other', 'nsdap', 10/12);
    if (!Q.works_program) {
        transferVoters('rural', 'dnvp', 'nsdap', 3/12);
        transferVoters('old_middle', 'dvp', 'nsdap', 5/12);
    }
}

if (Q.year === 1931) {
    transferVoters('new_middle', 'dvp', 'nsdap', 6/12);
    transferVoters('old_middle', 'dvp', 'nsdap', 6/12);
    if (!Q.works_program) {
        transferVoters('unemployed', 'spd', 'nsdap', 7/12);
        transferVoters('unemployed', 'spd', 'kpd', 2/12);
    }
}

if (Q.year === 1932) {
    transferVoters('new_middle', 'other', 'dnvp', 4/12);
    transferVoters('old_middle', 'other', 'dnvp', 4/12);
    transferVoters('old_middle', 'other', 'nsdap', 12/12);
    transferVoters('rural', 'other', 'nsdap', 10/12);
}

// Anti-Inertia
if (Q.year >= 1934 && (Q.inflation >= 8 || Q.unemployed >= 20) && Q.pro_republic <= 45 && Q.spd_in_government) {
    for (var c of Q.classes) {
        transferVoters(c, 'spd', 'nsdap', 6/12);
    }
}

// Clean floating point drift across demographic matrices after operations
for (var c of Q.classes) {
    for (var party of Q.parties) {
        var key = c + '_' + party;
        if (Q[key] !== undefined) {
            Q[key] = cleanFloat(Math.max(0, Q[key]));
        }
    }
}

// ============================================================================
// 5. MATRIX NORMALIZATION & ELECTORAL DOT-PRODUCT
// ============================================================================

var decimalFactor = Math.pow(10, Q.use_decimals || 0);

// Class Vote Normalization
for (var c of Q.classes) {
    var classVotes = 0;
    for (var party of Q.parties) {
        if (Q[c + '_' + party] < 0) Q[c + '_' + party] = 0;
        classVotes += Q[c + '_' + party];
    }
    for (var party of Q.parties) {
        var normVal = (classVotes > 0) ? (100 * Q[c + '_' + party] / classVotes) : 0;
        Q[c + '_' + party + '_normalized'] = cleanFloat(normVal);
        Q[c + '_' + party + '_display'] = cleanFloat(Math.round(decimalFactor * normVal) / decimalFactor, 2);
    }
}

// National Support Dot-Product
var totalSupport = 0;
for (var party of Q.parties) {
    var partySupport = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            partySupport += Q[c] * Q[c + '_' + party];
        } else {
            partySupport += Q[c] * Q[c + '_' + party + '_normalized'];
        }
    }
    Q[party + '_support'] = cleanFloat(partySupport);
    totalSupport += partySupport;
}

// National Share Normalization
for (var party of Q.parties) {
    var normShare = (totalSupport > 0) ? (Q[party + '_support'] / totalSupport) : 0;
    Q[party + '_normalized'] = cleanFloat(normShare);
    Q[party + '_votes'] = Math.round(normShare * 100);
    Q[party + '_votes_display'] = cleanFloat(Math.round(decimalFactor * normShare * 100) / decimalFactor, 2);
}

// ============================================================================
// 6. FACTIONAL ALIGNMENT & SYSTEM DISSENT
// ============================================================================

// Bound individual factions within [0, 100%]
for (var f of Q.factions) {
    if (Q[f + '_dissent'] < 0) Q[f + '_dissent'] = 0;
    if (Q[f + '_dissent'] > 100) Q[f + '_dissent'] = 100;
    if (Q[f + '_strength'] < 0) Q[f + '_strength'] = 0;
}

var totalStrength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;

if (totalStrength > 0) {
    Q.left_strength = cleanFloat(100 * Q.left_strength / totalStrength);
    Q.center_strength = cleanFloat(100 * Q.center_strength / totalStrength);
    Q.labor_strength = cleanFloat(100 * Q.labor_strength / totalStrength);
    Q.reformist_strength = cleanFloat(100 * Q.reformist_strength / totalStrength);
    Q.neorevisionist_strength = cleanFloat(100 * Q.neorevisionist_strength / totalStrength);
}

var weightedDissent = (
    Q.left_strength * Q.left_dissent +
    Q.center_strength * Q.center_dissent +
    Q.labor_strength * Q.labor_dissent +
    Q.reformist_strength * Q.reformist_dissent +
    Q.neorevisionist_strength * Q.neorevisionist_dissent
);

// Standardized 100% boundary cap across party dissent indices
var globalDissentFraction = (totalStrength > 0) ? (0.01 * weightedDissent / totalStrength) : 0;
Q.dissent = cleanFloat(Math.min(1.0, Math.max(0, globalDissentFraction)));
Q.dissent_percent = cleanFloat(Q.dissent * 100, 2);

// ============================================================================
// 7. EVENT DISPATCHER & ASSET PRELOADER
// ============================================================================

// Corrected global variable leakage
Q.has_event = 0;

var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);

if (choices && choices.length > 0 && choices[0].title !== "Continue...") {
    Q.has_event = 1;
} else {
    Q.has_event = 0;
}

// Corrected Image API source property
if (this.ui && this.ui.show_portraits && choices) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc && cc.faceImage) {
            var im = new Image();
            im.src = cc.faceImage;
        }
    }
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and difficulty == 0; main.main_easy if has_event = 0 and difficulty < 0; main.main_historical if difficulty >= 2; main.main_hard if difficulty == 1

= [+ weeks: monther +], [+ month : month +] [+ year +]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
