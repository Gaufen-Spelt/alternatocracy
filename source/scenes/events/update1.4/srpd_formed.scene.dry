on-arrival: {!
// set up the infrastructure
Q.srpd_formed = 1;
Q.parties.push('srpd');
Q.srpd_name = "SRPD";
if (Q.neorev_split) {
    Q.srpd_name = "SRPD"
    Q.srpd_leader = "Horsing"
}
if (Q.reformists_resign) {
    Q.srpd_name = "SD"
    Q.srpd_leader = "Braun"
}
if (Q.neorev_split && Q.reformists_resign) {
    Q.srpd_name = "VSRPD"
    Q.srpd_leader = "Heller"
}

Q.workers_srpd = 6;
Q.workers_spd -= 3;
Q.new_middle_srpd = 6;
Q.old_middle_srpd = 1;
Q.rural_srpd = 1;
Q.unemployed_srpd = 2;
Q.catholics_srpd = 1;

Q.workers_other -= 2;

if (Q.unions_independent) {
    Q.workers_srpd += 8;
}

// update all records
Q.srpd_r = 0;
Q.old_srpd_r = 0;
for (var record of Q.election_records) {
    record['srpd'] = 0;
}
for (var record of Q.party_support_records) {
    record['srpd'] = 0;
}
!}
