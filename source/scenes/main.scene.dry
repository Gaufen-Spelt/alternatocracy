title: Next month
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 turn.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' turns.';
}

if (Q.fundraiser_timer == 1) {
    Q.pinnedCardsDescription += '\n- next fundraiser in 1 turn';
} else {
    Q.pinnedCardsDescription += '\n- next fundraiser in ' + Q.fundraiser_timer + ' turns.';
}

// ============================================================
// LIVE DATE HEADER
// Updates <span id="date-header"> in place, no scene reload needed.
// Runs regardless of hitler_rubicon, so the header stays live even
// when the reaction clock isn't running (e.g. after player actions).
// ============================================================
if (!window.__dateHeaderStarted) {
    window.__dateHeaderStarted = true;

    // EDIT THESE to match your `monther` and `month` quality labels.
    var MONTHER_LABELS = { 0: 'Early', 1: 'Early', 2: 'Late', 3: 'Late' };
    var MONTH_NAMES = ['', 'January', 'February', 'March', 'April', 'May', 'June',
                       'July', 'August', 'September', 'October', 'November', 'December'];

    window.updateDateHeader = function () {
        var el = document.getElementById('date-header');
        if (!el) return;

        var parts = [];
        if (Q.hitler_rubicon >= 1) {
            parts.push('Day: ' + (Q.day || 0));
            parts.push('Week: ' + (Q.week || 0));
        }
        parts.push(MONTHER_LABELS[Q.weeks] !== undefined ? MONTHER_LABELS[Q.weeks] : Q.weeks);
        parts.push((MONTH_NAMES[Q.month] || Q.month) + ' ' + Q.year);

        var text = parts.join(', ');
        if (el.textContent !== text) el.textContent = text;
    };

    // Cheap poll: only touches the DOM when the text actually changes.
    window.__dateHeaderTimer = setInterval(window.updateDateHeader, 250);
}
// Also refresh right after this scene renders.
setTimeout(function () { if (window.updateDateHeader) window.updateDateHeader(); }, 0);

if (Q.hitler_rubicon >= 1) {
if (!window.__reactionClockStarted) {
    window.__reactionClockStarted = true;

    // Defaults (only set if missing, so saves keep their values)
    if (Q.reaction_window_ms === undefined) Q.reaction_window_ms = 3500; // real ms per 7 days at 1x
    if (Q.reaction_days_needed === undefined) Q.reaction_days_needed = 7;
    if (Q.speed_multiplier === undefined)   Q.speed_multiplier = 1;
    if (Q.paused === undefined)             Q.paused = 0;
    if (Q.day === undefined)                Q.day = 0;       // cumulative day counter (cosmetic)
    if (Q.idle_days === undefined)          Q.idle_days = 0; // days waited on main since last reset
    if (Q._last_year === undefined)         Q._last_year = Q.year;

    function dayTick() {
        try {
            var engine = dendryUI.dendryEngine;
            var onMain = (engine.state.sceneId === 'main');

            if (!Q.paused && onMain) {
                Q.day += 1;
                Q.idle_days += 1;

                // advisor timer: once per 30 days
                if (Q.advisor_action_timer > 0 && Q.day % 30 === 0) {
                    Q.advisor_action_timer -= 1;
                }

                // Player was too slow: trigger a post_event step
                if (Q.idle_days >= Q.reaction_days_needed) {
                    Q.idle_days = 0;
                    Q.month_actions = (Q.month_actions || 0) + 1;
                }

                // Run post_event logic every day (keeps event checks responsive).
                // The month step only fires when month_actions >= 1.
                var postEventScene = engine.game.scenes['post_event'];
                if (postEventScene && postEventScene.onArrival) {
                    engine._runActions(postEventScene.onArrival);
                    if (Q.has_event) {
                        engine.__changeScene('post_event');
                    }
                }

                // post_event owns the calendar; catch year rollovers here
                if (Q.year > Q._last_year) {
                    if (Q.historical_mode) Q.resources += 2 * (Q.year - Q._last_year);
                    Q._last_year = Q.year;
                }

                window.updateSidebar();
                window.updateNewsSidebar();
                if (window.updateDateHeader) window.updateDateHeader();
            } else if (!onMain) {
                // Player left the scene in time: reset the reaction window
                Q.idle_days = 0;
            }

            // Still allow status redraw if user is on status page
            if (Q.current_scene === 'status' && typeof visit === 'function') {
                visit('status');
            }
        } catch (e) {
            console.error('dayTick error:', e);
        }

        // Re-schedule each time so speed changes apply immediately.
        var perDay = (Q.reaction_window_ms || 3500) / (Q.reaction_days_needed || 7);
        var delay = perDay / (Q.speed_multiplier || 1);
        window.__reactionTimer = setTimeout(dayTick, Math.max(100, delay));
    }

    window.__reactionTimer = setTimeout(dayTick, 500);
}
}

!}
max-cards: 4



