Title: Organized Capitalism & State Regulation
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: month_actions += 1; organized_capitalism_timer += 16
on-display: {!
window.updateOrgCapPanel = function() {
  var Q = dendryUI.dendryEngine.state.qualities;
  $('.orgcap-panel').each(function() {
    var $p = $(this), all = true;
    $p.find('.orgcap-col').each(function() {
      var on = (Number(Q[$(this).attr('data-q')]) || 0) >= 1;
      if (!on) all = false;
      $(this).find('.orgcap-bar').css({
        background: on ? '#E3000F' : '#999',
        opacity: on ? 1 : 0.35
      });
      $(this).find('.orgcap-label').css('opacity', on ? 1 : 0.5);
    });
    $p.find('.orgcap-symbol').css({
      color: all ? '#E3000F' : '#999',
      opacity: all ? 1 : 0.3,
      textShadow: all ? '0 0 14px #E3000F' : 'none',
      webkitTextStroke: all ? '1px #FFD700' : '0'
    });
  });
};

window.updateOrgCapPanel();
                                                                   
!}
view-if: (economic_minister == "Hilferding" or finance_minister == "Hilferding" or economic_minister == "Naphtali") and spd_in_government and organized_capitalism_timer <= 0 and economic_democracy >= 3
card-image: img/organcap.jpg
face-image: img/organcap.jpg

= Organized Capitalism & State Regulation

{!
