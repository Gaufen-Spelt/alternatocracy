</style>!}


@achievements
title: Achievements
view-if: achievement_game_completed == 1
tags: endings
go-to: eg_menu if started == 1; root.start_menu_2 if started == 0

= Achievements

{!<div class="ach-section">!}

[? if achievement_eiserne_front :
{!<div class="ach" style="background:rgba(200,0,0,0.1)"><div class="ach-icon-box" style="background:rgba(200,0,0,0.25)"><img class="ach-icon" src="img/achievements/eiserne_front.png"></div><div class="ach-body"><strong>Eiserne Front</strong> - form the Iron Front.!}[? if game_achievement_eiserne_front : {!<span class="ach-new">New!</span>!}?]{!</div></div>!}
?]
[? if not achievement_eiserne_front :
{!<div class="ach ach-locked"><div class="ach-icon-box"><img class="ach-icon" src="img/achievements/eiserne_front.png"></div><div class="ach-body"><strong>Eiserne Front</strong> - form the Iron Front.</div></div>!}
?]

[? if achievement_civil_war :
{!<div class="ach ach-red"><div class="ach-icon-box"><img class="ach-icon" src="img/achievements/civil_war.png"></div><div class="ach-body"><strong>Bürgerkrieg</strong> - enter a long civil war.!}[? if game_achievement_civil_war : {!<span class="ach-new">New!</span>!}?]{!</div></div>!}
?]
[? if not achievement_civil_war :
{!<div class="ach ach-locked"><div class="ach-icon-box"><img class="ach-icon" src="img/achievements/civil_war.png"></div><div class="ach-body"><strong>Bürgerkrieg</strong> - enter a long civil war.</div></div>!}
?]

[? if achievement_einigkeit :
{!<div class="ach" style="background:rgba(0,91,150,0.12)"><div class="ach-icon-box" style="background:rgba(0,91,150,0.25)"><img class="ach-icon" src="img/achievements/einigkeit.png"></div><div class="ach-body"><strong>Einigkeit</strong> - reach the end of the game without a civil war on easy.!}[? if game_achievement_einigkeit : {!<span class="ach-new">New!</span>!}?]{!</div></div>!}
?]
[? if not achievement_einigkeit :
{!<div class="ach ach-locked"><div class="ach-icon-box"><img class="ach-icon" src="img/achievements/einigkeit.png"></div><div class="ach-body"><strong>Einigkeit</strong> - reach the end of the game without a civil war on easy.</div></div>!}
?]

[? if achievement_einigkeit_und_recht :
{!<div class="ach" style="background:rgba(0,91,150,0.12)"><div class="ach-icon-box" style="background:rgba(0,91,150,0.25)"><img class="ach-icon" src="img/achievements/einigkeit_und_recht.png"></div><div class="ach-body"><strong>Einigkeit und Recht</strong> - reach the end of the game without a civil war on normal.!}[? if game_achievement_einigkeit_und_recht : {!<span class="ach-new">New!</span>!}?]{!</div></div>!}
?]
[? if not achievement_einigkeit_und_recht :
