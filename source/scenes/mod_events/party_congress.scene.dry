title: Party Congress 
subtitle: Factions are vying for control.
tags: event
view-if: year > party_congress_year or (year = party_congress_year and month >= party_congress_month)
new-page: true
on-arrival: party_congress_year = year + 4

= Party Congress has been declared

The new party congress is open. Factions are voicing their opinions and the struggle for the control has begun.

- @count: And...

@count
on-arrival: {!

Q.left_r = 0;
Q.center_r = 0;
Q.labor_r = 0;
Q.ref_r = 0;
Q.neo_r = 0;
Q.soc_r = 0;
Q.eth_r = 0;

Q.left_r = Q.left_strength;
Q.center_r = Q.center_strength;
Q.labor_r = Q.labor_strength;
Q.ref_r = Q.reformist_strength;
Q.neo_r = Q.neorevisionist_strength;

if (Q.socialpatriotism >= 1) {
    Q.soc_r = Q.socialpatriot_strength;
}

if (Q.ethical_socialism >= 1) {
    Q.eth_r = Q.ethical_strength;
}

// 3. Find the highest value and signal it
var r_values = {
    left: Q.left_r,
    center: Q.center_r,
    labor: Q.labor_r,
    ref: Q.ref_r,
    neo: Q.neo_r,
    soc: Q.soc_r,
    eth: Q.eth_r
};

var top_name = "";
var top_value = -Infinity;

for (var key in r_values) {
    if (r_values[key] > top_value) {
        top_value = r_values[key];
        top_name = key;
    }
}

Q.highest_r = top_value;     // the highest value
Q.highest_faction = top_name; // which faction holds it

if (Q.highest_r <= 30) {
    Q.spd_party_leader = "collective";
} else {
    switch (Q.highest_faction) {
        case "left":
            Q.spd_party_leader = Q.levi_dead ? "Rosenfeld" : "Levi";
            break;
        case "center":
            Q.spd_party_leader = Q.economic_minister == "Naphtali" ? "Hilferding" : "Wels";
            break;
        case "labor":
            Q.spd_party_leader = "Leipart";
            break;
        case "ref":
            Q.spd_party_leader = "Braun";
            break;
        case "neo":
            Q.spd_party_leader = "Mierendorff";
            break;
        case "eth":
            Q.spd_party_leader = "Eichler";
            break;
        case "soc":
            Q.spd_party_leader = "Heller";
            break;
    }
}
!}

= [+ spd_party_leader +] has been selected to the Leadership.

- @advisors: Now, advisors...

@advisors
on-arrival: {!

// Reset factional advisors
var names = ["levi", "sender", "rosenfeld", "seydewitz", "siemsen",
             "hilferding", "wels", "muller", "breitscheid",
             "severing", "braun", "juchacz", "pfulf",
             "leipart", "aufhauser", "wissell", "woytinsky",
             "mierendorff", "leber", "schumacher"];

for (var i = 0; i < names.length; i++) {
    Q[names[i] + "_advisor"] = 0;
}

Q.n_advisors = 0;
Q.left_advisors = 0;
Q.center_advisors = 0;
Q.labor_advisors = 0;
Q.ref_advisors = 0;
Q.neo_advisors = 0;

// Rank factions
var f = [
    {k: "left",   r: Q.left_r},
    {k: "center", r: Q.center_r},
    {k: "labor",  r: Q.labor_r},
    {k: "ref",    r: Q.ref_r},
    {k: "neo",    r: Q.neo_r}
];
if (Q.socialpatriotism >= 1 && Q.has_soc_advisors) {
    f.push({k: "soc", r: Q.soc_r});
}
if (Q.ethical_socialism >= 1 && Q.has_eth_advisors) {
    f.push({k: "eth", r: Q.eth_r});
}

f.sort(function(a, b) { return b.r - a.r; });

// Allocate 3 slots
var slots = {left: 0, center: 0, labor: 0, ref: 0, neo: 0, soc: 0, eth: 0};
var lead1 = f[0].r - f[1].r;
var lead2 = f[1].r - f[2].r;

if (lead1 >= 30) {
    slots[f[0].k] = 3;
} else if (lead1 >= 15) {
    slots[f[0].k] = 2;
    slots[f[1].k] = 1;
} else if (lead2 >= 15) {
    slots[f[0].k] = 1;
    slots[f[1].k] = 2;
} else {
    slots[f[0].k] = 1;
    slots[f[1].k] = 1;
    slots[f[2].k] = 1;
}

// Cap slots by how many advisors are actually available
var pool = {left: 0, center: 0, labor: 0, ref: 0, neo: 0, soc: 0, eth: 0};

pool.left   = Q.left_split ? 0 : (Q.levi_dead ? 4 : 5);
pool.center = Q.centrists_resign ? 1 : (Q.muller_dead ? 3 : 4);
pool.ref    = Q.reformists_resign ? 1 : 4;
pool.labor  = Q.unions_independent ? 1 : 4;
pool.neo    = (Q.neorevisionism > 0) ? (Q.neorev_split ? 2 : 3) : 0;

for (var key in slots) {
    slots[key] = Math.min(slots[key], pool[key]);
}

Q.left_slots = slots.left;
Q.center_slots = slots.center;
Q.labor_slots = slots.labor;
Q.ref_slots = slots.ref;
Q.neo_slots = slots.neo;
Q.soc_slots = slots.soc;
Q.eth_slots = slots.eth;

Q.total_slots = slots.left + slots.center + slots.labor
              + slots.ref + slots.neo + slots.soc + slots.eth;
!}
go-to: advisor_menu

@advisor_menu
title: Appoint advisors
on-display: {!

var TOTAL_SEATS = Q.total_seats || 100;  // seats in the chart

var factions = [
    { id: 'left',       label: 'Klassenkampf Linke',                  val: Q.left_strength,       color: '#B30000' },
    { id: 'center',     label: 'Materialist / Center Marxists',       val: Q.center_strength,     color: '#E8590C' },
    { id: 'labor',      label: 'Arbeitergewerkschaft',                val: Q.labor_strength,      color: '#F2B705' },
    { id: 'reformist',  label: 'Reformist / Evolutionary Socialists', val: Q.reformist_strength,  color: '#E3000F' }
];

var neorevLabel = (Q.social_patriotism == 1)
    ? 'Social Republicans / Militant Democrats'
    : 'Neorevisionist / Militant Democrats';

if (Q.ethical_socialism >= 1) {
    factions.push({
        id: 'ethical',
        label: 'Ethical Socialists (ISK)',
        val: Q.ethical_strength,
        color: '#8B4513'
    });
}

if (Q.neorevisionism >= 1) {
    factions.push({ id: 'neorev', label: neorevLabel, val: Q.neorevisionist_strength, color: '#7A3E9D' });
}
if (Q.social_patriotism == 1) {
    factions.push({ id: 'socialpatriot', label: "Hamburg's Group (Socialist Patriots)", val: Q.socialpatriot_strength, color: '#2E7D6B' });
}

// ---- Allocate seats by strength (largest remainder) ----
var totalStrength = 0;
factions.forEach(function(f) { f.val = Math.max(0, f.val || 0); totalStrength += f.val; });

if (totalStrength > 0) {
    var assigned = 0;
    factions.forEach(function(f) {
        var exact = f.val / totalStrength * TOTAL_SEATS;
        f.seats = Math.floor(exact);
        f.rem = exact - f.seats;
        assigned += f.seats;
    });
    var order = factions.slice().sort(function(a, b) { return b.rem - a.rem; });
    for (var k = 0; assigned < TOTAL_SEATS; k = (k + 1) % order.length) {
        order[k].seats++;
        assigned++;
    }
}

// ---- Parliament chart (factions) ----
var chartData = factions.filter(function(f) { return f.seats > 0; }).map(function(f) {
    return { id: f.id, name: f.label, seats: f.seats, color: f.color, outline: '#222' };
});

var svgEl = d3.select('#parliament-chart');
if (!svgEl.empty() && chartData.length) {
    var w = 600;

    svgEl.selectAll('*').remove();
    svgEl
        .attr('viewBox', '-6 -6 ' + (w + 12) + ' ' + (w / 2 + 16))
        .attr('preserveAspectRatio', 'xMidYMid meet')
        .attr('width', null)
        .attr('height', null)
        .style('width', '100%')
        .style('height', 'auto')
        .style('overflow', 'visible');

    var chart = d3.parliament().width(w).innerRadiusCoef(0.4);

    // animations off
    chart.enter.smallToBig(false);
    chart.enter.fromCenter(false);
    chart.update.animate(false);
    chart.exit.bigToSmall(false);
    chart.exit.toCenter(false);

    svgEl.datum(chartData).call(chart);

    var legend = '';
    chartData.forEach(function(d) {
        legend += '<div><span style="display:inline-block;width:10px;height:10px;background:' +
                  d.color + ';margin-right:6px;"></span>' + d.name + ' (' + d.seats + ')</div>';
    });
    d3.select('#parliament-legend').html(legend);
}

// ---- Faction strengths ----
var fhtml = '<b>Faction Strengths</b><br>';
factions.forEach(function(f) {
    fhtml += '<div style="margin:4px 0;">' + f.label +
             (Q.deterministic_mode == 1 ? ' (' + f.val + ')' : '') +
             '<div style="background:#ddd;height:8px;">' +
             '<div style="background:' + f.color + ';height:8px;width:' + Math.min(100, f.val) + '%;"></div>' +
             '</div></div>';
});
d3.select('#faction-strengths').html(fhtml);

!}

<svg id="parliament-chart"></svg>
<div id="parliament-legend"></div>
<div id="faction-strengths"></div>

The congress has apportioned the advisory seats by faction strength.

[? if left_slots > 0 : Left: [+ left_advisors +]/[+ left_slots +]. ?][? if center_slots > 0 : Center: [+ center_advisors +]/[+ center_slots +]. ?][? if labor_slots > 0 : Labor: [+ labor_advisors +]/[+ labor_slots +]. ?][? if ref_slots > 0 : Reformist: [+ ref_advisors +]/[+ ref_slots +]. ?][? if neo_slots > 0 : Neorevisionist: [+ neo_advisors +]/[+ neo_slots +]. ?]

- #center_advisor
- #left_advisor
- #reformist_advisor
- #labor_advisor
- #neorev_advisor
- #nonfactional_advisor
- @cancel_factional
- @reshuffle_independent
- @advisors_done

@cancel_factional
title: Cancel faction appointments
subtitle: Withdraw every faction advisor and choose again.
view-if: n_advisors > 0
on-arrival: {!
var names = ["levi", "sender", "rosenfeld", "seydewitz", "siemsen",
             "hilferding", "wels", "muller", "breitscheid",
             "severing", "braun", "juchacz", "pfulf",
             "leipart", "aufhauser", "wissell", "woytinsky",
             "mierendorff", "leber", "schumacher"];
for (var i = 0; i < names.length; i++) {
    Q[names[i] + "_advisor"] = 0;
}
Q.n_advisors = 0;
Q.left_advisors = 0;
Q.center_advisors = 0;
Q.labor_advisors = 0;
Q.ref_advisors = 0;
Q.neo_advisors = 0;
!}
go-to: advisor_menu

The faction appointments have been withdrawn.

@reshuffle_independent
title: Reshuffle the independent advisor
subtitle: Release the independent seat and choose someone else.
view-if: n_nonfactional_advisors > 0
on-arrival: {!
Q.baade_advisor = 0;
Q.hirschfeld_advisor = 0;
Q.radbruch_advisor = 0;
Q.stampfer_advisor = 0;
Q.n_nonfactional_advisors = 0;
!}
go-to: advisor_menu

The independent seat is open again.

@advisors_done
title: Conclude the congress
choose-if: n_advisors >= total_slots
unavailable-subtitle: Every faction seat must be filled first.
on-arrival: {!
// Strength bonuses are applied once, when appointments are final
var bonus = {
    levi: ["left_strength", 5], sender: ["left_strength", 5], rosenfeld: ["left_strength", 5],
    seydewitz: ["left_strength", 5], siemsen: ["left_strength", 5],
    severing: ["reformist_strength", 5], braun: ["reformist_strength", 5], juchacz: ["reformist_strength", 5],
    leipart: ["labor_strength", 5], aufhauser: ["labor_strength", 5],
    wissell: ["labor_strength", 3], woytinsky: ["labor_strength", 3],
    mierendorff: ["neorevisionist_strength", 5], schumacher: ["neorevisionist_strength", 5],
    leber: ["neorevisionist_strength", 5]
};
for (var k in bonus) {
    if (Q[k + "_advisor"] == 1) {
        Q[bonus[k][0]] += bonus[k][1];
    }
}
!}
go-to: root

################### centrists

@add_hilferding
title: Rudolf Hilferding
subtitle: <span style="display: flex; align-items: flex-start; gap: 12px;"><img src="img/portraits/HilferdingRudolf.jpg" style="width: 25%; height: auto; object-fit: cover; border: 5px solid #000000ff; flex-shrink: 0;"><span>Hilferding is an economist and a disciple of Karl Kautsky. Originating from Vienna, Austria, he trained as a medical doctor, but later became involved in Marxist economics as a discipline. He has been the lead ideologist of our party since the Heidelberg Program of 1925.</span></span>{!<br><br>!}[? if difficulty < 0 : Actions - Against Right and Left, Defending Toleration, Fiscal Policy, Economic Democracy ?]
tags: center_advisor
view-if: hilferding_advisor = 0 and center_advisors < center_slots and centrists_resign = 0
on-arrival: hilferding_advisor = 1; n_advisors += 1; center_advisors += 1
go-to: advisor_menu

