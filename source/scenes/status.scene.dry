@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}
on-display: {!
window.renderReichstagMini = function(svgId, barId) {
    var Q = window.dendryUI.dendryEngine.state.qualities;
    var svgEl = document.getElementById(svgId);
    var barEl = document.getElementById(barId);
    if (!svgEl || !barEl) return;
    if (!Q.partyData) return; // no election has run yet

    if (!document.getElementById('reichstag-mini-style')) {
        var style = document.createElement('style');
        style.id = 'reichstag-mini-style';
        style.textContent =
            '#' + svgId + ' .seat.spd { stroke: none !important; }\n' +
            '#' + svgId + ' .seat.in-coalition { stroke: #FFD700 !important; stroke-width: 0.3px !important; }';
        document.head.appendChild(style);
    }
    var coalitionParties = {};
    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        if (Q[p + '_in_government'] == 1) {
            coalitionParties[p] = true;
        }
    }

    var visibleParties = Q.partyData.filter(function(p) { return p.show && p.seats > 0; });
    var data = visibleParties.map(function(p) {
        return { id: p.id, legend: p.name, name: p.name, seats: p.seats };
    });

    if (window && d3) {
        var container = svgEl.parentElement;
        var maxWidth = 280;
        var width = Math.min(maxWidth, container.offsetWidth || maxWidth);
        var height = Math.round(width / 2);

        svgEl.style.width = width + "px";
        svgEl.style.height = height + "px";

        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(false).smallToBig(false);
        parliament.exit.toCenter(false).bigToSmall(false);
        parliament.update.animate(false);

        d3.select("#" + svgId).datum(data).call(parliament);

        d3.select("#" + svgId).selectAll(".seat").classed("in-coalition", function(d) {
            return d.party && coalitionParties[d.party.id];
        });

        var totalSeats = visibleParties.reduce(function(sum, p) { return sum + p.seats; }, 0);
        barEl.innerHTML = "";
        barEl.style.display = "flex";
        barEl.style.width = "100%";
        barEl.style.height = "20px";
        barEl.style.marginTop = "6px";
        barEl.style.overflow = "hidden";
        barEl.style.borderRadius = "3px";

        visibleParties.forEach(function(p) {
            var pct = p.seats / totalSeats;
            var seg = document.createElement("div");
            seg.style.width = (pct * 100) + "%";
            seg.style.height = "100%";
            seg.style.backgroundColor = p.color;
            seg.style.display = "flex";
            seg.style.alignItems = "center";
            seg.style.justifyContent = "center";
            seg.style.overflow = "hidden";
            seg.style.boxSizing = "border-box";
            seg.title = p.name + ": " + p.seats + " seats";

            if (coalitionParties[p.id]) {
                seg.style.outline = "0.3px solid #FFD700";
                seg.style.outlineOffset = "-0.3px";
            }

            if (pct > 0.06) {
                var label = document.createElement("span");
                label.style.fontSize = "8px";
                label.style.fontWeight = "bold";
                label.style.color = "#fff";
                label.style.textShadow = "0 0 2px #000, 0 0 2px #000";
                label.style.whiteSpace = "nowrap";
                label.style.pointerEvents = "none";
                label.textContent = p.name + " " + Math.round(pct * 100) + "%";
                seg.appendChild(label);
            }
            barEl.appendChild(seg);
        });
    }
};

window.renderReichstagMini && window.renderReichstagMini('reichstag-mini', 'party-color-bar-mini');
!}

