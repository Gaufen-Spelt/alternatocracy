title: Status
new-page: true
is-special: true
on-arrival: {!


if (Q.peoples_party >= 1) {
    Q.spd_status = "People's Party";
} else {
    Q.spd_status = "Worker's Party";
}

if (Q.country_name == "Weimar Republic" && Q.presidential_powers >= 1) {
    Q.country_name = "German Republic"
} 

Q.country_name_display = Q.country_name || "Weimar Republic";



var flagSlugMap = {
  "Weimar Republic": "weimar",
  "German Republic": "weimar_reformed",
  "German Council Republic": "council_republic",
  "Communist Republic of Germany": "communist_republic",
  "German National State": "national_state",
  "German Empire": "empire",
  "German State": "junta",
  "Third Reich": "third_reich"
};
Q.flag_slug = flagSlugMap[Q.country_name_display] || "weimar";

var getMinisterStr = function(party, minister) {
    if (!minister || minister === "None") return "—";
    if (!party || party === "None") return minister;
    return minister + " (" + party + ")";
};

var cabinetRows = [
    ["Foreign", getMinisterStr(Q.foreign_minister_party, Q.foreign_minister)],
    ["Interior", getMinisterStr(Q.interior_minister_party, Q.interior_minister)],
    ["Justice", getMinisterStr(Q.justice_minister_party, Q.justice_minister)],
    ["Labor", getMinisterStr(Q.labor_minister_party, Q.labor_minister)],
    ["Economic", getMinisterStr(Q.economic_minister_party, Q.economic_minister)],
    ["Finance", getMinisterStr(Q.finance_minister_party, Q.finance_minister)],
    ["Agriculture", getMinisterStr(Q.agriculture_minister_party, Q.agriculture_minister)],
    ["Reichswehr", Q.reichswehr_minister || "—"]
];

var html = '<table style="width: 100%; font-size: 0.82em; border-collapse: collapse; margin-top: 6px;">';
html += '<tr style="border-bottom: 1px solid #888; text-align: left;"><th style="padding: 2px 0;">Ministry</th><th style="padding: 2px 0;">Appointee</th></tr>';

for (var i = 0; i < cabinetRows.length; i++) {
    html += '<tr style="border-bottom: 1px solid #ddd;">';
    html += '<td style="padding: 3px 2px 3px 0; font-weight: bold; width: 40%; vertical-align: top;">' + cabinetRows[i][0] + '</td>';
    html += '<td style="padding: 3px 0; width: 60%; vertical-align: top;">' + cabinetRows[i][1] + '</td>';
    html += '</tr>';
}
html += '</table>';

Q.cabinet_table_display = html;


!}

