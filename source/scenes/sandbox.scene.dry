@checkcond
on-display: {!
if (!window.dendryUI.injectCondChecker) {
    window.dendryUI.injectCondChecker = function() {
        var container = document.getElementById('cond-checker');
        if (!container) return;
        container.innerHTML = '';

        var input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'e.g. spd_r > 20 && party_relations.SPD.KPD < 50';
        input.style.cssText =
            'background:#111; color:#0f0; border:1px solid #0f0;' +
            'padding:6px 10px; font-family:monospace; font-size:13px;' +
            'width:70%; outline:none; border-radius:2px;';

        var btn = document.createElement('button');
        btn.textContent = 'Eval';
        btn.style.cssText =
            'margin-left:8px; background:#0f0; color:#000; border:none;' +
            'padding:6px 12px; font-family:monospace; font-size:13px;' +
            'cursor:pointer; border-radius:2px;';

        var status = document.createElement('p');
        status.style.cssText = 'font-size:12px; margin-top:6px; min-height:16px; word-break:break-all;';

        var history = document.createElement('div');
        history.style.cssText = 'font-size:11px; margin-top:10px; color:#888; max-height:150px; overflow-y:auto;';

        function applyEval() {
            var raw = input.value.trim();
            if (!raw) return;

            var engine = window.dendryUI.dendryEngine;
            var Q = engine.state.qualities;
            var state = engine.state;
            var result;
            var isError = false;

            try {
                /*jshint -W054 */
                var fn = new Function('state', 'Q', 'return (' + raw + ');');
                /*jshint +W054 */
                result = fn.call(engine, state, Q);
            } catch (err) {
                isError = true;
                result = err.message;
            }

            if (isError) {
                status.style.color = '#f55';
                status.textContent = '✗ Error: ' + result;
            } else {
                var truthy = !!result;
                status.style.color = truthy ? '#5f5' : '#fa5';
                var displayVal;
                try {
                    displayVal = JSON.stringify(result);
                } catch (e) {
                    displayVal = String(result);
                }
                status.textContent = (truthy ? '✓ TRUE' : '✗ FALSE') + '  →  ' + displayVal;
            }

            var entry = document.createElement('div');
            entry.textContent = raw + '  =  ' + (isError ? 'ERROR: ' + result : JSON.stringify(result));
            history.insertBefore(entry, history.firstChild);
        }

        btn.addEventListener('click', applyEval);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') applyEval();
        });

        container.appendChild(input);
        container.appendChild(btn);
        container.appendChild(status);
        container.appendChild(history);
    };
}

window.dendryUI.injectCondChecker();
!}

= Evaluate any boolean/JS expression against live game state (same context as chooseIf/viewIf predicates).

{!<div id="cond-checker"></div>!}

*Supports full JS expressions: `&&`, `||`, comparisons, nested paths, even calling functions on Q. Read-only — does not modify state.*

- @technical: Back

@getvar
on-display: {!
if (!window.dendryUI.injectVarGetter) {
    window.dendryUI.injectVarGetter = function() {
        var container = document.getElementById('var-getter');
        if (!container) return;
        container.innerHTML = '';

        var input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'e.g. spd_r  or  party_relations.SPD.KPD';
        input.style.cssText =
            'background:#111; color:#0f0; border:1px solid #0f0;' +
            'padding:6px 10px; font-family:monospace; font-size:13px;' +
            'width:60%; outline:none; border-radius:2px;';

        var btn = document.createElement('button');
        btn.textContent = 'Get';
        btn.style.cssText =
            'margin-left:8px; background:#0f0; color:#000; border:none;' +
            'padding:6px 12px; font-family:monospace; font-size:13px;' +
            'cursor:pointer; border-radius:2px;';

        var status = document.createElement('p');
        status.style.cssText = 'color:#5ff; font-size:12px; margin-top:6px; height:16px; word-break:break-all;';

        function applyGet() {
            var raw = input.value.trim();
            if (!raw) return;

            if (!/^[a-zA-Z_][a-zA-Z0-9_.]*$/.test(raw)) {
                status.style.color = '#f55';
                status.textContent = '✗ Format must be: varname or dotted.path';
                return;
            }

            var path = raw.split('.');
            var target = Q;
            var found = true;

            for (var i = 0; i < path.length; i++) {
                var part = path[i];
                if (target === undefined || target === null || typeof target !== 'object' || !(part in target)) {
                    found = false;
                    break;
                }
                target = target[part];
            }

            if (!found) {
                status.style.color = '#f55';
                status.textContent = '✗ Not found: ' + raw;
                return;
            }

            status.style.color = '#5ff';
            status.textContent = raw + ' = ' + JSON.stringify(target);
        }

        btn.addEventListener('click', applyGet);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') applyGet();
        });

        container.appendChild(input);
        container.appendChild(btn);
        container.appendChild(status);
    };
}

window.dendryUI.injectVarGetter();
!}

= Read any Q variable directly. Format: varname, or nested.path

{!<div id="var-getter"></div>!}

*Read-only: this does not modify game state.*

- @technical: Back

@setvar
on-display: {!
if (!window.dendryUI.injectVarSetter) {
    window.dendryUI.injectVarSetter = function() {
        var container = document.getElementById('var-setter');
        if (!container) return;
        container.innerHTML = '';

        var input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'e.g. spd_r = 25  or  party_relations.SPD.KPD = 80';
        input.style.cssText =
            'background:#111; color:#0f0; border:1px solid #0f0;' +
            'padding:6px 10px; font-family:monospace; font-size:13px;' +
            'width:60%; outline:none; border-radius:2px;';

        var btn = document.createElement('button');
        btn.textContent = 'Set';
        btn.style.cssText =
            'margin-left:8px; background:#0f0; color:#000; border:none;' +
            'padding:6px 12px; font-family:monospace; font-size:13px;' +
            'cursor:pointer; border-radius:2px;';

        var status = document.createElement('p');
        status.style.cssText = 'color:#f55; font-size:12px; margin-top:6px; height:16px;';

        function parseValue(valStr) {
            if (valStr === 'true') return true;
            if (valStr === 'false') return false;
            if (valStr === 'null') return null;
            if (!isNaN(parseFloat(valStr)) && isFinite(valStr)) return parseFloat(valStr);
            if ((valStr.startsWith('"') && valStr.endsWith('"')) ||
                (valStr.startsWith("'") && valStr.endsWith("'"))) {
                return valStr.slice(1, -1);
            }
            return valStr;
        }

        function applySet() {
            var raw = input.value.trim();
            if (!raw) return;

            var match = raw.match(/^([a-zA-Z_][a-zA-Z0-9_.]*)\s*=\s*(.+)$/);
            if (!match) {
                status.style.color = '#f55';
                status.textContent = '✗ Format must be: varname = value';
                return;
            }

            var path = match[1].split('.');
            var valStr = match[2].trim();
            var val = parseValue(valStr);

            var target = Q;
            for (var i = 0; i < path.length - 1; i++) {
                var part = path[i];
                if (target[part] === undefined || target[part] === null || typeof target[part] !== 'object') {
                    target[part] = {};
                }
                target = target[part];
            }

            var lastKey = path[path.length - 1];
            var oldVal = target[lastKey];
            target[lastKey] = val;

            status.style.color = '#5f5';
            status.textContent = '✓ ' + match[1] + ': ' + JSON.stringify(oldVal) + ' → ' + JSON.stringify(val);
            input.value = '';

            // Force a redraw of sidebar, bottom panel, AND the current
            // scene's own content, since on-display alone doesn't re-render
            // [+ +] interpolations already on screen.
            if (window.updateSidebar) window.updateSidebar();
            if (window.updateBottomPanel) window.updateBottomPanel();

            var engine = window.dendryUI.dendryEngine;
            var sceneId = engine.state.sceneId;
            var scene = engine.game.scenes[sceneId];
            if (scene) {
                var contentEl = document.getElementById('content');
                if (contentEl) {
                    var displayContent = engine._makeDisplayContent(scene.content, true);
                    var html = window.dendryUI.contentToHTML.convert(displayContent);
                    // Re-render just this scene's rendered block, not the whole
                    // page history — find the last rendered page block if present,
                    // otherwise fall back to appending nothing and just refreshing
                    // sidebar/bottom panel.
                    var pages = contentEl.querySelectorAll('.page');
                    if (pages.length) {
                        var lastPage = pages[pages.length - 1];
                        lastPage.innerHTML = html;
                    }
                }
            }
        }

        btn.addEventListener('click', applySet);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') applySet();
        });

        container.appendChild(input);
        container.appendChild(btn);
        container.appendChild(status);
    };
}

window.dendryUI.injectVarSetter();
!}

= Set any Q variable directly. Format: varname = value, or nested.path = value

{!<div id="var-setter"></div>!}

*Reminder: changes here are not run through any game logic — they bypass validation, normalization, and any side effects that normally fire when these variables change elsewhere. Use with care, and consider saving before edits.*

- @technical: Back

@goto
on-display: {!
if (!window.dendryUI.injectSceneJumper) {
    window.dendryUI.injectSceneJumper = function() {
        var engine = window.dendryUI.dendryEngine;
        var container = document.getElementById('scene-jumper');
        if (!container) return;
        container.innerHTML = '';

        var input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'scene id (e.g. main, post_event.events_choice)';
        input.style.cssText =
            'background:#111; color:#0f0; border:1px solid #0f0;' +
            'padding:6px 10px; font-family:monospace; font-size:13px;' +
            'width:60%; outline:none; border-radius:2px;';

        var btn = document.createElement('button');
        btn.textContent = 'Go';
        btn.style.cssText =
            'margin-left:8px; background:#0f0; color:#000; border:none;' +
            'padding:6px 12px; font-family:monospace; font-size:13px;' +
            'cursor:pointer; border-radius:2px;';

        var status = document.createElement('p');
        status.style.cssText = 'color:#f55; font-size:12px; margin-top:6px; height:16px;';

        function jump() {
            var id = input.value.trim();
            if (!id) return;
            if (!engine.game || !engine.game.scenes || !engine.game.scenes[id]) {
                status.textContent = '✗ No such scene: "' + id + '"';
                return;
            }
            engine.goToScene(id);
        }

        btn.addEventListener('click', jump);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') jump();
        });

        container.appendChild(input);
        container.appendChild(btn);
        container.appendChild(status);
    };
}

window.dendryUI.injectSceneJumper();
!}

